<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Adaptive-icon background for Agentic. Uses the app's AMOLED surface
        palette (AgenticSurfaceVariant #111A2B -> near-black) so the orb
        foreground sits on the same dark tile on every launcher shape.
        This replaces the pure-white system background that showed through
        the transparent corners of the legacy PNG icon.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="76.4"
                android:startColor="#131C2B"
                android:endColor="#04060B" />
        </aapt:attr>
    </path>
</vector>
